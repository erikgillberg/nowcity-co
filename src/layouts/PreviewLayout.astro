---
// Preview layout: the Edgewater editorial framework applied to the main site.
// Self-contained (links the west-salem site.css, no Tailwind), noindex.
interface Props { title: string; description?: string; active?: string; }
const { title, description = 'Now City Inc. is a regenerative developer and operator, turning underused sites into walkable, green, mixed-use districts across the West Coast.', active = '' } = Astro.props;
const fullTitle = title === 'Now City Inc.' ? title : `${title} · Now City Inc.`;
const nav = [
  { href: '/preview/approach', label: 'Approach', key: 'approach' },
  { href: '/preview/services', label: 'Services', key: 'services', children: [
    { href: '/preview/stack', label: 'The Stack' },
    { href: '/preview/services', label: 'How We Work' },
  ] },
  { href: '/preview/investment', label: 'Investment', key: 'investment' },
  { href: '/preview/faqs', label: 'FAQs', key: 'faqs' },
  { href: '/preview/team', label: 'Team', key: 'team' },
  { href: '/preview/contact', label: 'Contact', key: 'contact' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="noindex, nofollow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/west-salem/assets/site.css?v=6" />
<style is:global>
  .g-2up{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  @media(max-width:640px){.g-2up{grid-template-columns:1fr!important}}
  .pv-icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:50%;background:rgba(168,112,63,.10);color:var(--terra);margin-bottom:16px}
  .pv-icon svg{width:23px;height:23px;stroke:currentColor;stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
  .dark .pv-icon{background:rgba(217,162,108,.16);color:#d9a26c}
  .faqlist{max-width:880px}
  .faq{border-bottom:1px solid var(--line)}
  .faq summary{list-style:none;cursor:pointer;padding:19px 44px 19px 0;position:relative;font-family:var(--serif);font-size:18px;color:var(--ink-deep);line-height:1.45}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:'+';position:absolute;right:4px;top:15px;font-size:24px;font-weight:400;color:var(--terra);font-family:var(--sans);line-height:1;transition:transform .2s}
  .faq[open] summary::after{content:'\2212'}
  .faq summary:hover{color:var(--terra)}
  .faq-a{padding:0 44px 22px 0}
  .faq-a p{font-size:14.5px;line-height:1.7;color:#4a463f}
  .faq-a p + p{margin-top:11px}
</style>
</head>
<body>
<nav id="nav">
  <div class="wrap">
    <a class="brand" href="/preview/">Now City<span class="brand-sub"> &middot; Regenerative districts</span></a>
    <ul class="navlinks">
      {nav.map((item) => (
        item.children ? (
          <li class="dd"><a href={item.href} class={active===item.key ? 'active' : ''}>{item.label}</a>
            <ul class="ddm">
              {item.children.map((c) => (<li><a href={c.href}>{c.label}</a></li>))}
            </ul>
          </li>
        ) : (
          <li><a href={item.href} class={active===item.key ? 'active' : ''}>{item.label}</a></li>
        )
      ))}
    </ul>
  </div>
</nav>

<slot />

<!-- CTA -->
<section class="dark cta" id="interest">
  <div class="wrap rv">
    <div class="eyebrow">Get in touch</div>
    <h2 class="serif">Let's build better<br>places, together.</h2>
    <p class="muted" style="max-width:620px;margin:0 auto">If any of this resonates, we would love to hear from you, whether you are an investor, a landowner, a city, a future resident, or simply curious. No commitment, just the start of a conversation.</p>
    <div class="contacts">
      <a href="/preview/investment">Investment overview &rarr;</a>
      <a href="mailto:team@nowcitylabs.com">team@nowcitylabs.com</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap" style="padding-bottom:26px;margin-bottom:26px;border-bottom:1px solid #2b2823;display:flex;gap:24px;align-items:center;justify-content:space-between;flex-wrap:wrap">
    <div style="max-width:440px">
      <div class="eyebrow" style="color:#e8c79d;margin-bottom:7px">Stay in the loop</div>
      <div style="color:#cfc9bd;font-size:14.5px;line-height:1.55">Follow the work as it unfolds. Occasional updates on Now City, the neighborhoods, and the ideas behind them. No noise.</div>
    </div>
    <form action="https://nowcitylabs.us19.list-manage.com/subscribe/post?u=88bfb2c8f34fdd20e85cce03f&amp;id=9c44948c78&amp;f_id=0098bbe7f0" method="post" target="_blank" novalidate style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;min-width:290px">
      <input type="email" name="EMAIL" required placeholder="you@email.com" aria-label="Email address" style="flex:1;min-width:210px;padding:12px 14px;border:1px solid #4a453a;border-radius:8px;background:#2b2823;color:#e9e5da;font-size:15px" />
      <div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name="b_88bfb2c8f34fdd20e85cce03f_9c44948c78" tabindex="-1" value="" /></div>
      <button type="submit" name="subscribe" style="padding:12px 22px;border:none;border-radius:8px;background:var(--terra);color:#fff;font-weight:600;font-size:14px;letter-spacing:.03em;cursor:pointer;white-space:nowrap">Get updates</button>
    </form>
  </div>
  <div class="wrap" style="display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:28px;align-items:start">
    <div>
      <div class="serif" style="font-size:17px;color:#bdb7a8">Now City Inc.</div>
      <p style="margin-top:10px;max-width:320px;line-height:1.6">Housing, work, play, food, wellness, and mobility in one connected daily life. The best of the past and the future. Now.</p>
    </div>
    <div>
      <div class="eyebrow" style="color:#e8c79d;margin-bottom:10px">Our Brands</div>
      <div style="line-height:1.9"><a href="https://nowcity.life">Now City Neighborhoods</a> &middot; residents<br><a href="/preview/services">Now City Labs</a> &middot; landowners &amp; operators<br><a href="https://nowcity.ai">NowCity.ai</a> &middot; deal teams &amp; capital</div>
    </div>
    <div>
      <div class="eyebrow" style="color:#e8c79d;margin-bottom:10px">Visit</div>
      <div style="line-height:1.9">101 Cooper Street<br>Santa Cruz, CA 95060<br><a href="/preview/contact">Contact</a></div>
    </div>
  </div>
  <div class="wrap" style="margin-top:26px;padding-top:18px;border-top:1px solid #2b2823;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <div>&copy; 2026 Now City Inc. All rights reserved.</div>
    <div>Preview &middot; editorial redesign for review</div>
  </div>
</footer>

<a href="#top" class="toplink" id="toplink" aria-label="Back to top">&uarr;</a>
<script>
  const nav=document.getElementById('nav');const tl=document.getElementById('toplink');
  function onScroll(){nav.classList.toggle('scrolled',scrollY>40);if(tl)tl.classList.toggle('show',scrollY>window.innerHeight)}
  addEventListener('scroll',onScroll,{passive:true});onScroll();
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.08});
  document.querySelectorAll('.rv').forEach(el=>io.observe(el));
  // mobile hamburger (mirror west-salem nav.js behavior)
  (function(){var w=nav.querySelector('.wrap');var links=nav.querySelector('.navlinks');if(!w||!links)return;
    var b=document.createElement('button');b.className='navtoggle';b.setAttribute('aria-label','Menu');b.innerHTML='<span></span><span></span><span></span>';w.appendChild(b);
    b.addEventListener('click',function(){nav.classList.toggle('navopen')});
    Array.prototype.forEach.call(links.querySelectorAll('.dd>a'),function(a){a.addEventListener('click',function(e){if(window.matchMedia('(max-width:860px)').matches){e.preventDefault();a.parentNode.classList.toggle('open')}})});
  })();
</script>
</body>
</html>
