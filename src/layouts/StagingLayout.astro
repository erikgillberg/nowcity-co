---
import { Image } from 'astro:assets';
interface Props {
  title: string;
  eyebrow?: string;
  heading?: string;
  sub?: string;
  heroImg?: any;
  heroAlt?: string;
  heroCaption?: string;
  compact?: boolean;
}
const { title, eyebrow, heading, sub, heroImg, heroAlt = '', heroCaption, compact = false } = Astro.props;
const nav = [
  ['/staging/', 'Home'],
  ['/staging/approach/', 'Approach'],
  ['/staging/services/', 'Services'],
  ['/staging/stack/', 'The Stack'],
  ['/staging/investment/', 'Investment'],
  ['/staging/team/', 'Team'],
  ['/staging/faqs/', 'FAQs'],
  ['/staging/contact/', 'Contact'],
];
const path = Astro.url.pathname.replace(/index\.html$/, '');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>{title} · Now City (staging)</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style is:global>
:root{
  --paper:#f7f2e6;--paper-2:#fdfaf2;--ink:#2a2723;--ink-deep:#1c1a17;--ink-soft:#57503f;--ink-mut:#8a8272;
  --sky:#7fb5d6;--sky-soft:#cfe3ef;--sky-deep:#33597a;--teal:#2e8a96;--moss:#46583d;
  --leaf:#7fa05a;--sun:#e9b45c;--coral:#d97e5a;--line:rgba(42,39,35,.12);
  --serif:'Libre Baskerville',Georgia,serif;--sans:'Inter',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.66;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}
img{display:block}
.wrap{max-width:1120px;margin:0 auto;padding:0 26px}
section{padding:92px 0}
@media(max-width:640px){section{padding:60px 0}}
h1,h2,h3{font-family:var(--serif);line-height:1.14;letter-spacing:-.012em;color:var(--ink-deep)}
h2{font-size:clamp(29px,3.8vw,42px)}
h3{font-size:20px}
.eyebrow{font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:var(--teal)}
.eyebrow.on-img{color:#fff;opacity:.92;text-shadow:0 1px 10px rgba(20,18,16,.6)}
.lede{font-size:18.5px;color:var(--ink-soft);line-height:1.66;max-width:720px}
.muted{color:var(--ink-mut)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 25px;border-radius:999px;font-weight:600;font-size:15px;transition:.18s;cursor:pointer}
.btn.sky{background:var(--sky-deep);color:#f2f7fa}.btn.sky:hover{background:#274a68;transform:translateY(-1px)}
.btn.sun{background:var(--sun);color:#3d2f14}.btn.sun:hover{background:#dfa53f;transform:translateY(-1px)}
.btn.ghost{border:1.5px solid var(--sky-deep);color:var(--sky-deep)}.btn.ghost:hover{background:var(--sky-deep);color:#fff}
.btn.ghost-light{border:1.5px solid rgba(255,255,255,.75);color:#fff}.btn.ghost-light:hover{background:#fff;color:var(--ink-deep)}
.btns{display:flex;gap:13px;flex-wrap:wrap}

/* staging banner + nav */
.stagebar{background:var(--sky-deep);color:#dcebf5;text-align:center;font-size:12px;padding:8px 16px;letter-spacing:.05em}
.stagebar b{color:#fff}
header.site{position:relative;z-index:20}
.navbar{display:flex;align-items:center;justify-content:space-between;max-width:1120px;margin:0 auto;padding:20px 26px;gap:18px;flex-wrap:wrap}
.navbar .mark{font-family:var(--serif);font-weight:700;font-size:20px;color:var(--ink-deep)}
.navbar .mark span{color:var(--teal)}
.navbar ul{display:flex;gap:22px;list-style:none;font-size:14px;font-weight:500;color:var(--ink-soft);flex-wrap:wrap}
.navbar ul a:hover{color:var(--teal)}
.navbar ul a.on{color:var(--teal);font-weight:700}
.onhero .navbar .mark{color:#fff}
.onhero .navbar ul{color:rgba(255,255,255,.88)}
.onhero .navbar ul a:hover,.onhero .navbar ul a.on{color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.5)}

/* full-bleed hero */
.shero{position:relative;display:flex;align-items:flex-end;min-height:62vh;overflow:hidden}
.shero.tall{min-height:82vh}
.shero .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.shero .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(28,26,23,.34) 0%,rgba(28,26,23,.05) 40%,rgba(28,26,23,.78) 100%)}
.shero .wrap{position:relative;padding-bottom:56px;padding-top:120px}
.shero h1{font-size:clamp(36px,5.6vw,64px);color:#fff;max-width:820px;text-shadow:0 2px 26px rgba(20,18,16,.5)}
.shero .sub{margin-top:20px;font-size:19px;line-height:1.6;color:rgba(255,255,255,.95);max-width:640px;text-shadow:0 1px 12px rgba(20,18,16,.55)}
.shero .cap{margin-top:26px;font-family:var(--serif);font-style:italic;font-size:14px;color:rgba(255,255,255,.82)}

/* watercolor interstitial */
.wcband{height:clamp(250px,32vw,360px);background-size:cover;background-position:center 32%;position:relative}
.wcband::before{content:"";position:absolute;inset:0;background:linear-gradient(rgba(247,242,230,.85),transparent 24%,transparent 76%,rgba(247,242,230,.85))}
.wcband.to-dark::before{background:linear-gradient(rgba(247,242,230,.85),transparent 24%,transparent 72%,rgba(28,26,23,.9))}
.wcband.from-dark::before{background:linear-gradient(rgba(28,26,23,.9),transparent 28%,transparent 76%,rgba(247,242,230,.85))}

/* dark analytical sections */
.darksec{background:var(--ink-deep);color:#e9e4d6}
.darksec h2,.darksec h3{color:#f4efe2}
.darksec .eyebrow{color:var(--sun)}
.darksec .lede,.darksec p{color:#c9c2b0}
.statgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1px;background:rgba(233,180,92,.25);border:1px solid rgba(233,180,92,.25);border-radius:12px;overflow:hidden;margin-top:40px}
.statgrid div{background:var(--ink-deep);padding:26px 22px}
.statgrid .n{font-family:var(--serif);font-size:clamp(26px,3vw,38px);color:var(--sun)}
.statgrid .l{margin-top:8px;font-size:13px;color:#b7b0a0;line-height:1.55}

/* cards */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-top:42px}
.card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 2px 5px rgba(42,39,35,.06),0 16px 40px rgba(51,89,122,.1);transition:transform .25s}
.card:hover{transform:translateY(-4px)}
.card .ph{height:180px;overflow:hidden}
.card .ph img{width:100%;height:100%;object-fit:cover}
.card .tx{padding:24px 24px 28px}
.card .tx p{font-size:14.5px;color:var(--ink-soft);margin-top:9px;line-height:1.66}
.card .icon-row{display:flex;align-items:center;gap:12px}

/* image door tiles */
.doors{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:24px;margin-top:42px}
.door{position:relative;border-radius:16px;overflow:hidden;min-height:360px;display:flex;align-items:flex-end;box-shadow:0 18px 44px rgba(42,39,35,.16)}
.door > img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .45s}
.door:hover > img{transform:scale(1.045)}
.door .tx{position:relative;width:100%;padding:26px;background:linear-gradient(transparent,rgba(28,26,23,.85) 62%);color:#fff}
.door .tx h3{color:#fff;font-size:23px}
.door .tx p{font-size:14px;color:rgba(255,255,255,.88);margin-top:8px;line-height:1.6}
.door .go{display:inline-block;margin-top:12px;font-weight:600;font-size:14px;color:#fff;border-bottom:2px solid var(--sun);padding-bottom:2px}

/* icons */
.icon{width:28px;height:28px;stroke:var(--teal);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}
.darksec .icon{stroke:var(--sun)}

/* prose duo */
.duo{display:grid;grid-template-columns:5fr 7fr;gap:56px;align-items:start}
@media(max-width:820px){.duo{grid-template-columns:1fr}}
.duo .prose p+p{margin-top:16px}
.duo .prose p{color:var(--ink-soft);font-size:16px}
.rule{height:2px;width:44px;background:var(--sun);border:0;margin:0 0 20px}

/* tables & faq */
.tbl{width:100%;border-collapse:collapse;font-size:14.5px;margin-top:30px}
.tbl th{font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--teal);text-align:left;padding:12px 14px;border-bottom:2px solid var(--line)}
.tbl td{padding:14px;border-bottom:1px solid var(--line);vertical-align:top;color:var(--ink-soft);line-height:1.6}
.tbl td:first-child{font-weight:600;color:var(--ink-deep)}
details.faq{border-bottom:1px solid var(--line);padding:22px 0}
details.faq summary{cursor:pointer;font-family:var(--serif);font-size:19px;color:var(--ink-deep);list-style:none;display:flex;justify-content:space-between;gap:16px}
details.faq summary::after{content:"+";font-family:var(--sans);color:var(--teal);font-size:22px;line-height:1}
details.faq[open] summary::after{content:"–"}
details.faq p{margin-top:14px;color:var(--ink-soft);font-size:15.5px;max-width:820px}

/* footer */
footer.site{background:var(--ink-deep);color:#cfc8b6;margin-top:0}
footer.site .cols{display:grid;grid-template-columns:2fr 1fr 1fr;gap:36px;max-width:1120px;margin:0 auto;padding:64px 26px 40px}
@media(max-width:760px){footer.site .cols{grid-template-columns:1fr}}
footer.site .mark{font-family:var(--serif);font-weight:700;font-size:20px;color:#fff}
footer.site .mark span{color:var(--sky)}
footer.site .h{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--sun);margin-bottom:14px}
footer.site ul{list-style:none;font-size:14px;display:grid;gap:9px}
footer.site a:hover{color:#fff}
footer.site .base{border-top:1px solid rgba(255,255,255,.12);padding:22px 26px;max-width:1120px;margin:0 auto;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:12px;color:#8f887a}

[data-reveal]{opacity:0;transform:translateY(14px);transition:opacity .7s ease,transform .7s ease}
[data-reveal].is-visible{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){[data-reveal]{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="stagebar"><b>Staging preview</b> · the new direction for nowcity.co</div>
<header class="site" class:list={[heroImg ? 'onhero' : '']} style={heroImg ? 'margin-bottom:-92px' : ''}>
  <div class="navbar">
    <a class="mark" href="/staging/">Now<span>City</span></a>
    <ul>
      {nav.map(([href, label]) => <li><a href={href} class:list={[path === href ? 'on' : '']}>{label}</a></li>)}
    </ul>
  </div>
</header>

{heroImg && (
  <div class:list={['shero', compact ? '' : 'tall']}>
    <Image src={heroImg} alt={heroAlt} widths={[1000,1600,2200]} sizes="100vw" class="bg" loading="eager" />
    <div class="shade"></div>
    <div class="wrap">
      {eyebrow && <p class="eyebrow on-img">{eyebrow}</p>}
      {heading && <h1 style="margin-top:14px" set:html={heading} />}
      {sub && <p class="sub">{sub}</p>}
      <slot name="hero-extra" />
      {heroCaption && <p class="cap">{heroCaption}</p>}
    </div>
  </div>
)}

<slot />

<footer class="site">
  <div class="cols">
    <div>
      <div class="mark">Now<span>City</span></div>
      <p style="margin-top:16px;font-size:14px;max-width:340px;line-height:1.7">A regenerative developer and operator. Building walkable, green districts on the West Coast.</p>
    </div>
    <div>
      <div class="h">Explore</div>
      <ul>
        <li><a href="/staging/approach/">Approach</a></li>
        <li><a href="/staging/services/">Services</a></li>
        <li><a href="/staging/stack/">The Stack</a></li>
        <li><a href="/staging/investment/">Investment</a></li>
      </ul>
    </div>
    <div>
      <div class="h">Connect</div>
      <ul>
        <li><a href="/staging/team/">Team</a></li>
        <li><a href="/staging/faqs/">FAQs</a></li>
        <li><a href="/staging/contact/">Contact</a></li>
        <li><a href="https://nowcity.life">nowcity.life</a></li>
        <li><a href="https://nowcity.ai">nowcity.ai</a></li>
      </ul>
    </div>
  </div>
  <div class="base">
    <span>© {new Date().getFullYear()} Now City Inc. All rights reserved.</span>
    <span>Watercolor visualizations and street rendering by the Now City team.</span>
  </div>
</footer>

<script>
  const io = new IntersectionObserver((es,obs)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');obs.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px',threshold:.06});
  document.querySelectorAll('[data-reveal]').forEach(el=>io.observe(el));
</script>
</body>
</html>
