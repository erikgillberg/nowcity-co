---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Now City Inc. develops walkable, regenerative neighborhoods on the West Coast and operates a platform of brands serving residents, partners, and capital.',
} = Astro.props;

const fullTitle = title === 'Now City Inc.' ? title : `${title} · Now City Inc.`;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const nav = [
  { href: '/approach', label: 'Approach' },
  {
    href: '/services',
    label: 'Services',
    children: [
      { href: '/stack', label: 'The Stack' },
      { href: '/services', label: 'How We Work' },
      { href: '/outcomes', label: 'Outcomes' },
    ],
  },
  { href: '/investment', label: 'Investment' },
  { href: '/faqs', label: 'FAQs' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-forest-700 focus:px-4 focus:py-2 focus:text-cream focus:no-underline"
    >
      Skip to content
    </a>

    <header class="border-b border-stone-100/60 bg-cream/80 backdrop-blur-sm">
      <div class="container-wide flex items-center justify-between py-5">
        <a href="/" class="no-underline" aria-label="Now City home">
          <Wordmark class="h-9 w-auto md:h-10" />
        </a>
        <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
          {nav.map((item) => (
            item.children ? (
              <div class="group relative">
                <a
                  href={item.href}
                  aria-haspopup="true"
                  class:list={[
                    'inline-flex items-center gap-1 text-sm font-medium no-underline tracking-tight',
                    currentPath.startsWith(item.href)
                      ? 'text-forest-700'
                      : 'text-stone-600 hover:text-forest-700',
                  ]}
                >
                  {item.label}
                  <svg class="h-3 w-3 opacity-70" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                {/* pt-3 forms an invisible hover bridge between trigger and menu */}
                <div class="invisible absolute left-1/2 top-full z-40 -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                  <div class="min-w-[13rem] rounded-xl border border-stone-100 bg-cream p-2 shadow-lg">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class:list={[
                          'block rounded-lg px-3 py-2 text-sm font-medium no-underline tracking-tight',
                          currentPath === child.href
                            ? 'bg-cream-50 text-forest-700'
                            : 'text-stone-600 hover:bg-cream-50 hover:text-forest-700',
                        ]}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'text-sm font-medium no-underline tracking-tight',
                  currentPath.startsWith(item.href)
                    ? 'text-forest-700'
                    : 'text-stone-600 hover:text-forest-700',
                ]}
              >
                {item.label}
              </a>
            )
          ))}
        </nav>

        <!-- Mobile menu toggle: visible below md, hidden at md+ where the inline nav shows -->
        <button
          id="mobile-nav-toggle"
          type="button"
          class="inline-flex items-center justify-center rounded-md p-2 text-stone-600 hover:text-forest-700 md:hidden"
          aria-label="Open menu"
          aria-controls="mobile-nav"
          aria-expanded="false"
        >
          <svg id="mobile-nav-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
          </svg>
          <svg id="mobile-nav-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile nav panel -->
      <nav
        id="mobile-nav"
        class="hidden border-t border-stone-100/60 md:hidden"
        aria-label="Mobile"
      >
        <div class="container-wide flex flex-col py-3">
          {nav.map((item) => (
            <Fragment>
              <a
                href={item.href}
                class:list={[
                  'py-3 text-base font-medium no-underline tracking-tight',
                  currentPath.startsWith(item.href)
                    ? 'text-forest-700'
                    : 'text-stone-600 hover:text-forest-700',
                ]}
              >
                {item.label}
              </a>
              {item.children && (
                <div class="mb-1 flex flex-col border-l border-stone-100 pl-4">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={[
                        'py-2 text-sm font-medium no-underline tracking-tight',
                        currentPath === child.href
                          ? 'text-forest-700'
                          : 'text-stone-600 hover:text-forest-700',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </Fragment>
          ))}
        </div>
      </nav>
    </header>

    <script>
      // Mobile nav toggle. Kept dependency-free so it works regardless of
      // hydration; toggles the panel and swaps the open/close icon.
      const navToggle = document.getElementById('mobile-nav-toggle');
      const navPanel = document.getElementById('mobile-nav');
      const iconOpen = document.getElementById('mobile-nav-icon-open');
      const iconClose = document.getElementById('mobile-nav-icon-close');
      if (navToggle && navPanel && iconOpen && iconClose) {
        navToggle.addEventListener('click', () => {
          const isOpen = navPanel.classList.toggle('hidden') === false;
          navToggle.setAttribute('aria-expanded', String(isOpen));
          navToggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
          iconOpen.classList.toggle('hidden', isOpen);
          iconClose.classList.toggle('hidden', !isOpen);
        });
      }
    </script>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-section">
      {/* Investor-interest CTA strip. Surfaces the form on every page so
          aligned partners don't have to dig for it. Anchor to #interest
          so the page scrolls straight to the form, not the page top. */}
      <div class="border-y border-stone-100 bg-cream-50">
        <div class="container-wide flex flex-col items-start justify-between gap-6 py-10 md:flex-row md:items-center">
          <div class="max-w-2xl">
            <p class="eyebrow">For investors and platform partners</p>
            <p class="mt-3 font-display text-xl text-forest-700 md:text-2xl">
              A non-binding indication of interest is the start of a conversation.
            </p>
          </div>
          <a href="/investment#interest" class="btn-outline whitespace-nowrap">
            Express interest
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="container-wide grid gap-8 py-12 md:grid-cols-3">
        <div>
          <Wordmark class="h-8 w-auto" />
          <p class="prose-body mt-5 max-w-sm text-sm">
            A regenerative neighborhood developer and operator. Building
            on the West Coast for the long now.
          </p>
        </div>
        <div>
          <p class="eyebrow">Our Brands</p>
          <ul class="mt-4 space-y-2 text-sm">
            <li>
              <a href="https://nowcity.life">Now City Neighborhoods</a>
              <span class="text-stone-400"> · for residents</span>
            </li>
            <li>
              <a href="/services">Services</a>
              <span class="text-stone-400"> · for landowners and operators</span>
            </li>
            <li>
              <a href="https://urbanreboot.org">Urban Reboot</a>
              <span class="text-stone-400"> · for public-private partnerships</span>
            </li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Visit</p>
          <ul class="mt-4 space-y-2 text-sm">
            <li class="text-stone-600">101 Cooper Street</li>
            <li class="text-stone-600">Santa Cruz, CA 95060</li>
            <li class="mt-3"><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="container-wide mt-12 flex flex-col items-start justify-between gap-2 border-t border-stone-100 pt-8 text-xs text-stone-500 md:flex-row md:items-center">
        <p>© {new Date().getFullYear()} Now City Inc. All rights reserved.</p>
        <p>
          <a href="/privacy" class="text-stone-500 hover:text-forest-700">Privacy</a>
          <span class="mx-2 text-stone-300">·</span>
          <a href="/cookies" class="text-stone-500 hover:text-forest-700">Cookies</a>
        </p>
      </div>
    </footer>
  </body>
</html>
