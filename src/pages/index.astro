---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import heroVision from '../assets/brand/hero-vision.jpg';
import buildingBlock from '../assets/brand/building-block.jpg';
import tiltShift from '../assets/brand/tiltshift-tnd-1.jpg';

const title = 'Now City Inc.';
const description =
  'Now City Inc. is a regenerative neighborhood developer and operator. We work on the West Coast through a platform of brands serving residents, landowners, and capital.';
---

<Layout title={title} description={description}>
  {/* ============================================================ */}
  {/* SECTION 1 — HERO                                             */}
  {/* ============================================================ */}
  <section class="pt-12 md:pt-20">
    <div class="container-wide">
      <div class="max-w-4xl">
        <p class="eyebrow">Now City Inc.</p>
        <h1 class="mt-5 font-display text-display-xl text-forest-700">
          We unlock the hidden value in land. And build walkable, green,
          mixed-use districts.
        </h1>
        <p class="lede mt-8 max-w-3xl">
          Now City Inc. is a regenerative developer and operator. Through
          adaptive reuse and ground-up construction, we turn underused
          land and buildings into walkable, green, mixed-use districts.
          We work on the West Coast, for the long now.
        </p>
      </div>

      <div class="mt-14 overflow-hidden rounded-md shadow-sm">
        <Image
          src={heroVision}
          alt="An active mixed-use street with plant-clad buildings, a market, café tables, a bike lane, and people of all ages walking and gathering."
          widths={[800, 1200, 1800]}
          sizes="(min-width: 1024px) 1100px, 100vw"
          class="h-auto w-full object-cover"
          loading="eager"
        />
        <p class="mt-3 text-xs italic text-stone-500">
          Concept rendering. Walkable mixed-use district, Pacific
          Northwest typology.
        </p>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 2 — A DIFFERENT KIND OF REAL ESTATE COMPANY          */}
  {/* ============================================================ */}
  <section class="mt-section py-section">
    <div class="container-wide">
      <div class="grid gap-12 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-5">
          <p class="eyebrow">What we do</p>
          <h2 class="mt-5 font-display text-display-lg text-forest-700">
            A different kind of real estate company.
          </h2>
        </div>
        <div class="md:col-span-7">
          <div class="prose-body">
            <p>
              Most development optimizes for a single asset, a single
              capital structure, and a single transaction. We optimize
              for a place over decades.
            </p>
            <p>
              Now City Inc. is a vertically integrated developer and
              operator. We find the hidden value in underused land and
              buildings, then release it through adaptive reuse and
              ground-up construction, designed and built with a
              systems-led approach to urbanism. We steward the result
              long after construction. Our model treats a district as a
              coordinated system rather than a portfolio of buildings.
            </p>
            <p>
              The result: better outcomes for residents, lower lifecycle
              risk for capital, more resilient places for cities.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 3 — THREE BRANDS                                     */}
  {/* ============================================================ */}
  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Our brands</p>
        <h2 class="mt-5 font-display text-display-lg text-forest-700">
          Three doors. One company.
        </h2>
        <p class="lede mt-6">
          Now City Inc. is the parent of three brands. Each serves a
          distinct audience in the same regenerative urbanism.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <article class="rounded-2xl bg-cream p-8 ring-1 ring-stone-100">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
            For residents
          </p>
          <h3 class="mt-4 font-display text-2xl text-forest-700">
            Now City Neighborhoods
          </h3>
          <p class="prose-body mt-3 text-base">
            The places we build, designed for the parts of life that
            happen every day. Future residents follow along here.
          </p>
          <p class="mt-6">
            <a href="https://nowcity.life" class="text-sm font-medium">
              nowcity.life →
            </a>
          </p>
        </article>

        <article class="rounded-2xl bg-cream p-8 ring-1 ring-stone-100">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
            For landowners and operators
          </p>
          <h3 class="mt-4 font-display text-2xl text-forest-700">
            Now City Labs
          </h3>
          <p class="prose-body mt-3 text-base">
            Pre-development intelligence and integrated execution
            services for landowners, operators, and municipalities.
          </p>
          <p class="mt-6">
            <a href="/services" class="text-sm font-medium">
              Explore services →
            </a>
          </p>
        </article>

        <article class="rounded-2xl bg-cream p-8 ring-1 ring-stone-100">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
            For cities and civic partners
          </p>
          <h3 class="mt-4 font-display text-2xl text-forest-700">
            Urban Reboot
          </h3>
          <p class="prose-body mt-3 text-base">
            A nonprofit that catalyzes mission-aligned capital and
            structures public-private partnerships for mixed-income,
            mixed-use neighborhoods.
          </p>
          <p class="mt-6">
            <a href="https://urbanreboot.org" class="text-sm font-medium">
              urbanreboot.org →
            </a>
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 4 — THE STACK                                        */}
  {/* ============================================================ */}
  <section class="py-section">
    <div class="container-wide">
      <div class="grid gap-12 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-5">
          <p class="eyebrow">How we build</p>
          <h2 class="mt-5 font-display text-display-lg text-forest-700">
            Four layers. One integrated stack.
          </h2>
          <p class="prose-body mt-8">
            Most development sequences these as separate concerns. We
            treat them as one system, designed together, financed
            together, built together, operated together.
          </p>
        </div>
        <div class="md:col-span-7">
          <ol class="grid gap-y-10 sm:grid-cols-2 sm:gap-x-10">
            <li>
              <div class="h-px w-10 bg-copper-400" aria-hidden="true"></div>
              <p class="eyebrow mt-3">01 / Industrialized construction</p>
              <p class="prose-body mt-3 text-base">
                Off-site fabrication, kit-of-parts assembly, healthy
                materials. Better quality, less waste, faster delivery.
              </p>
            </li>
            <li>
              <div class="h-px w-10 bg-copper-400" aria-hidden="true"></div>
              <p class="eyebrow mt-3">02 / Green infrastructure</p>
              <p class="prose-body mt-3 text-base">
                Energy, water, mobility, and ecology, sized at the
                district scale. Lower capex and opex; resilience as a
                byproduct.
              </p>
            </li>
            <li>
              <div class="h-px w-10 bg-copper-400" aria-hidden="true"></div>
              <p class="eyebrow mt-3">03 / Regenerative placemaking</p>
              <p class="prose-body mt-3 text-base">
                Walkable streets, civic gathering, local economic
                development, community programming. Places people
                actually want to be.
              </p>
            </li>
            <li>
              <div class="h-px w-10 bg-copper-400" aria-hidden="true"></div>
              <p class="eyebrow mt-3">04 / Innovative finance</p>
              <p class="prose-body mt-3 text-base">
                Capital structures designed for long-term stewardship,
                not short-term exit. Aligned ownership across residents,
                operators, and investors.
              </p>
            </li>
          </ol>
          <p class="prose-body mt-10 text-base">
            <a href="/stack" class="font-medium">
              See the full stack →
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 5 — WHERE WE ARE                                     */}
  {/* ============================================================ */}
  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="grid gap-12 md:grid-cols-2 md:items-center md:gap-16">
        <div>
          <p class="eyebrow">Where we are</p>
          <h2 class="mt-5 font-display text-display-lg text-forest-700">
            Building on the West Coast.
          </h2>
          <p class="prose-body mt-8">
            We focus on California and the Pacific Northwest, where land
            use, climate, and policy momentum align. Our pipeline is in
            active development. First homes are scheduled for 2029.
          </p>
          <p class="prose-body mt-5">
            Now City Inc. is a young company with a long time horizon.
            We are looking for the right partners, landowners, civic,
            and capital, to grow with.
          </p>
        </div>
        <div class="overflow-hidden rounded-md shadow-sm">
          <Image
            src={tiltShift}
            alt="A tilt-shift view down a tree-lined main street with residential balconies, sidewalk cafés, umbrellas, and people walking the central pedestrian spine."
            widths={[600, 900, 1400]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="h-auto w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 6 — GET INVOLVED                                     */}
  {/* ============================================================ */}
  <section class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Get involved</p>
        <h2 class="mt-5 font-display text-display-lg text-forest-700">
          Patient ambitions need patient partners.
        </h2>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <article class="rounded-2xl bg-cream-50 p-8 ring-1 ring-stone-100">
          <h3 class="font-display text-xl text-forest-700">
            Landowners and operators
          </h3>
          <p class="prose-body mt-3 text-base">
            If you hold a site that wants to become a district, our
            services arm starts with a conversation.
          </p>
          <p class="mt-6">
            <a href="/services" class="text-sm font-medium">
              Explore services →
            </a>
          </p>
        </article>

        <article class="rounded-2xl bg-cream-50 p-8 ring-1 ring-stone-100">
          <h3 class="font-display text-xl text-forest-700">
            Investors and platform partners
          </h3>
          <p class="prose-body mt-3 text-base">
            We are building Now City Inc. as a platform for the next
            generation of real assets. Express interest, and we will be
            in touch when there is something to talk about.
          </p>
          <p class="mt-6">
            <a href="/investment" class="text-sm font-medium">
              Investment overview →
            </a>
          </p>
        </article>

        <article class="rounded-2xl bg-cream-50 p-8 ring-1 ring-stone-100">
          <h3 class="font-display text-xl text-forest-700">
            Future residents and the curious
          </h3>
          <p class="prose-body mt-3 text-base">
            Tell us where you would want a Now City neighborhood. We pay
            attention.
          </p>
          <p class="mt-6">
            <a href="https://nowcity.life" class="text-sm font-medium">
              nowcity.life →
            </a>
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>
