---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import heroAerial from '../../assets/watercolors/aerial-greenroofs.jpg';
import greenBridge from '../../assets/watercolors/green-bridge.jpg';
import forestCanopy from '../../assets/watercolors/forest-canopy.jpg';

const capabilities = [
  {
    eyebrow: 'Layer 01',
    num: '01',
    title: 'Intelligence',
    subtitle: 'AI-powered pre-development',
    blurb:
      'Feasibility, zoning, scenario modeling, and carrying-capacity analysis, before design begins. We answer what the land will actually support before anyone draws a building.',
    lines: [
      'Site feasibility and scenario modeling',
      'Zoning, entitlement, and compliance intelligence',
      'Grid, energy, and water carrying capacity',
      'Circular materials tracking and embodied-carbon modeling',
    ],
  },
  {
    eyebrow: 'Layer 02',
    num: '02',
    title: 'Systems',
    subtitle: 'Integrated development methodology',
    blurb:
      'The Now City Stack is a repeatable four-phase engagement framework that aligns land, systems, and program before the pro-forma locks in.',
    lines: [
      'Carrying Capacity & Opportunity Discovery',
      'Systems & Program Coordination',
      'Pro-Forma & Capital Structuring',
      'Development Execution & Stewardship',
    ],
  },
  {
    eyebrow: 'Layer 03',
    num: '03',
    title: 'Services',
    subtitle: 'Advisory, co-development, and activation',
    blurb:
      'We operate lean in early stages and bring the right partners in for the right moment, from entitlements through activation and long-term stewardship.',
    lines: [
      'Owner representation and strategic advisory',
      'Co-GP and mission-aligned JV structuring',
      'Mixed-use activation and ground-floor programming',
      'Municipal partnership and public-private facilitation',
    ],
  },
  {
    eyebrow: 'Layer 04',
    num: '04',
    title: 'Capital',
    subtitle: 'Innovative finance structuring',
    blurb:
      'We structure public tools, philanthropy, impact capital, and institutional equity into stacks that actually close and perform over decades.',
    lines: [
      'Blended-finance capital-stack design',
      'Impact and institutional capital alignment',
      'LIHTC, MFTE, and public-subsidy navigation',
      'Supportive-capital and co-investment facilitation',
    ],
  },
];

const techPrinciples = [
  { n: '01', t: 'Operating model first', d: 'What the place must enable.' },
  { n: '02', t: 'Interoperable', d: 'Systems must speak to each other.' },
  { n: '03', t: 'Pilot before scale', d: 'One block before district rollout.' },
  { n: '04', t: 'Built for handover', d: 'No black-box systems.' },
];
const capIcons = ['<svg viewBox="0 0 24 24"><path d="M12 3l1.7 5.1L19 10l-5.3 1.9L12 17l-1.7-5.1L5 10l5.3-1.9L12 3Z"/></svg>','<svg viewBox="0 0 24 24"><circle cx="6" cy="7" r="2.3"/><circle cx="18" cy="7" r="2.3"/><circle cx="12" cy="17" r="2.3"/><path d="M7.8 8.5l2.7 6.4M16.2 8.5l-2.7 6.4M8.3 7h7.4"/></svg>','<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M14.6 9.4l-2 5.2-5.2 2 2-5.2 5.2-2Z"/></svg>','<svg viewBox="0 0 24 24"><ellipse cx="9" cy="7" rx="5" ry="3"/><path d="M4 7v5c0 1.7 2.2 3 5 3"/><ellipse cx="15" cy="14" rx="5" ry="3"/><path d="M10 14.3v2.7c0 1.7 2.2 3 5 3s5-1.3 5-3v-3"/></svg>'];
---
<PreviewLayout title="The Stack" active="services">
  <header class="hero short" id="top">
    <div class="bg" style={`background-image:url(${heroAerial.src})`}></div><div class="shade"></div>
    <div class="wrap">
      <div class="eyebrow">The Now City Stack</div>
      <h1>Four layers.<br>One coordinated system.</h1>
      <p class="sub">Most projects do not struggle because the ideas are flawed. They struggle because the systems needed to support them are not aligned or sequenced. The Stack solves that.</p>
      <div class="meta">Intelligence &middot; Systems &middot; Services &middot; Capital</div>
    </div>
  </header>

  <!-- THE FOUR LAYERS -->
  <section>
    <div class="wrap">
      <div class="sec-head rv">
        <div class="eyebrow">The stack</div>
        <h2>Four integrated layers of capability.</h2>
        <p class="lead">Intelligence, Systems, Services, and Capital, applied to the single challenge of getting regenerative projects built.</p>
      </div>
      <div class="grid g2 g-2up rv">
        {capabilities.map((c, i) => (
          <div class="card">
            <span class="pv-icon" set:html={capIcons[i]}></span>
            <div class="eyebrow" style="margin:10px 0 4px">{c.eyebrow}</div>
            <h3>{c.title}</h3>
            <h4>{c.subtitle}</h4>
            <p style="font-size:14.5px;line-height:1.65;color:#4a463f">{c.blurb}</p>
            <ul class="tick">
              {c.lines.map((line) => (<li>{line}</li>))}
            </ul>
          </div>
        ))}
      </div>
      <div class="figure-block rv" style="margin-top:0">
        <img src={forestCanopy.src} alt="A forest canopy woven into the fabric of a walkable district." loading="lazy" />
        <div class="fig-cap">Ecology and natural systems carried through the plan, so a district gives more back to the land than it takes. Concept rendering.</div>
      </div>
    </div>
  </section>

  <!-- TECH STRATEGY -->
  <section class="dark">
    <div class="wrap">
      <div class="sec-head rv">
        <div class="eyebrow">Tech strategy</div>
        <h2>Right tech. Right time.</h2>
        <p class="lead">We are outcome-driven and tech-agnostic. Many projects pick technology too early, too late, or under vendor pressure, and end up with systems no one uses, tools that do not integrate, and operations that fail after handover.</p>
      </div>
      <div class="grid g2 rv" style="align-items:start">
        <p style="font-size:16.5px;line-height:1.75;color:#cfc9ba">We do the opposite. Technology decisions come only after the program, systems logic, and operating model are clear.</p>
        <div class="flow">
          {techPrinciples.map((p, i) => (
            <>
              {i > 0 && <div class="arrow">&rarr;</div>}
              <div class="step"><span class="n">{p.n}</span><span>{p.t}</span><span style="font-weight:400;font-size:12.5px;color:#a49d8c;margin-top:4px">{p.d}</span></div>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="alt">
    <div class="wrap">
      <div class="grid g2 rv" style="align-items:center;gap:44px">
        <div>
          <div class="eyebrow">Grounded in a real site</div>
          <h2 style="font-size:clamp(28px,3.6vw,40px);margin:14px 0 18px;color:var(--ink-deep)">Coordinated capability, applied to a specific site.</h2>
          <p style="font-size:16.5px;line-height:1.75;color:#4a463f">The Stack only matters when it is grounded in a real project. Let us talk about yours.</p>
          <p style="margin-top:18px"><a href="/preview/contact" style="color:var(--terra);font-weight:600;font-size:13.5px">Schedule a gateway call &rarr;</a></p>
        </div>
        <div class="figure-block rv" style="margin-top:0">
          <img src={greenBridge.src} alt="A planted pedestrian bridge threading green infrastructure through a district." loading="lazy" />
          <div class="fig-cap">Green infrastructure, energy, water, mobility, and ecology, sized to serve the whole district. Concept rendering.</div>
        </div>
      </div>
    </div>
  </section>
</PreviewLayout>
