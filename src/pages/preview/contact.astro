---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import heroImg from '../../assets/watercolors/village-green.jpg';
import streetBrick from '../../assets/watercolors/street-brick.jpg';

const paths = [
  { label:'Landowners and operators', body:'If you steward a site that could grow into a district, we would love to hear about it. Our services team walks it with you, one honest step at a time.', href:'/preview/services', cta:'Explore services' },
  { label:'Capital partners', body:'Whether you are drawn to backing the platform, co-investing in a project, or simply starting a partnership conversation, our Investment overview is a good place to begin.', href:'/preview/investment', cta:'Investment' },
  { label:'Cities and civic partners', body:'Public-private partnerships, planning collaborations, and early work we believe in all begin with a conversation through our services team.', href:'/preview/services', cta:'Explore services' },
  { label:'Future residents and the curious', body:'Tell us where you would want a Now City neighborhood. We pay attention.', href:'https://nowcity.life', cta:'nowcity.life' },
];
const pathIcons = ['<svg viewBox="0 0 24 24"><circle cx="8" cy="12" r="4"/><path d="M12 12h9"/><path d="M17.5 12v3.5"/><path d="M20.5 12v2.5"/></svg>','<svg viewBox="0 0 24 24"><path d="M4 16l5-5 3.5 3.5L20 7"/><path d="M15 7h5v5"/></svg>','<svg viewBox="0 0 24 24"><path d="M12 20S4 15 4 9.5A4 4 0 0 1 12 7a4 4 0 0 1 8 2.5C20 15 12 20 12 20Z"/></svg>','<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M14.6 9.4l-2 5.2-5.2 2 2-5.2 5.2-2Z"/></svg>'];
---
<PreviewLayout title="Contact" active="contact">
  <header class="hero short" id="top">
    <div class="bg" style={`background-image:url(${heroImg.src})`}></div><div class="shade"></div>
    <div class="wrap">
      <div class="eyebrow">Contact</div>
      <h1>Get in touch.</h1>
      <p class="sub">We read every message, and we would genuinely love to hear from you, whether you are an investor, a landowner, a city, a future resident, or simply curious about what we are building.</p>
      <div class="meta">General inquiries &middot; Services &middot; Partnerships &middot; Investment</div>
    </div>
  </header>

  <!-- PATHS -->
  <section>
    <div class="wrap">
      <div class="sec-head rv">
        <div class="eyebrow">Where to start</div>
        <h2>Four doors in.</h2>
        <p class="lead">Wherever you are coming from, an investor, a landowner, a city, a future resident, or simply curious, there is a way in. Each door opens a real conversation with the people who can help.</p>
      </div>
      <div class="grid g2 g-2up rv">
        {paths.map((p, i) => (
          <div class="card">
            <span class="pv-icon" set:html={pathIcons[i]}></span>
            <h4>Path</h4>
            <h3>{p.label}</h3>
            <p style="font-size:14.5px;line-height:1.65;color:#4a463f">{p.body}</p>
            <p style="margin-top:14px"><a href={p.href} style="color:var(--terra);font-weight:600;font-size:13.5px">{p.cta} &rarr;</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DIRECT CONTACT -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head rv">
        <div class="eyebrow">For everything else</div>
        <h2>Reach us directly.</h2>
        <p class="lead">Press, recruiting, advisor introductions, or anything we did not anticipate above:</p>
      </div>
      <div class="grid g2 rv">
        <div class="card on-alt">
          <h4>Email</h4>
          <h3><a href="mailto:team@nowcitylabs.com" style="color:var(--terra)">team@nowcitylabs.com</a></h3>
        </div>
        <div class="card on-alt">
          <h4>Mailing address</h4>
          <p style="font-size:16.5px;line-height:1.7;color:#4a463f">
            Now City Inc.<br />
            101 Cooper Street<br />
            Santa Cruz, CA 95060
          </p>
        </div>
      </div>
      <div class="figure-block rv" style="margin-top:36px"><img src={streetBrick.src} alt="A warm brick main street in soft daylight, with storefronts, trees, and people walking." loading="lazy" /><div class="fig-cap">The kind of street we hope you will one day walk with us. Concept rendering.</div></div>
    </div>
  </section>
</PreviewLayout>
