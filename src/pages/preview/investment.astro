---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import heroValley from '../../assets/brand/hero-valley.jpg';
import urbanConnectivity from '../../assets/brand/urban-connectivity.jpg';

const outcomes = [
  { k:'Financial', d:'Lower lifecycle risk through systems-led design. Stabilized operating margins from district-scale infrastructure. Insurance and resilience advantages.' },
  { k:'Resident', d:'Walkable daily life. Lower household transportation cost. Measurable health and wellbeing benefits from biophilic urbanism.' },
  { k:'Civic', d:'Tax base, local employment, attainable mixed-income housing. Predictable, well-aligned public-private partnerships.' },
  { k:'Ecological', d:'Net-positive site outcomes. Stormwater management. Habitat restoration. Embodied and operational carbon reduction.' },
];
const model = [
  { t:'Development', d:'Site selection, entitlement, and integrated design generate value before construction begins. The pro forma follows the systems, not the other way around.' },
  { t:'Operations', d:'Stabilized neighborhoods generate durable cash flow from rent, ground leases, and service revenue, with lower lifecycle risk than typical real estate portfolios.' },
  { t:'Platform', d:'Methodology, tools, and data improve every project. Services revenue and NowCity.ai software complement the core development engine, and every district makes the next one cheaper to underwrite.' },
];
---
<PreviewLayout title="Investment" active="investment">
  <header class="hero short" id="top">
    <div class="bg" style={`background-image:url(${heroValley.src})`}></div><div class="shade"></div>
    <div class="wrap">
      <div class="eyebrow">Investment</div>
      <h1>Building a platform for the<br>next generation of real assets.</h1>
      <p class="sub">Now City Inc. develops, operates, and stewards regenerative neighborhoods on the West Coast. We are building the team, methodology, and capital model to do this at scale.</p>
      <div class="meta">For institutional, family-office &amp; platform investors &middot; Patient capital &middot; First homes 2029</div>
    </div>
  </header>

  <!-- WHY REAL ASSETS -->
  <section>
    <div class="wrap">
      <div class="sec-head rv">
        <div class="eyebrow">Why real assets</div>
        <h2>The right kind of asset for the next decade.</h2>
        <p class="lead">Capital is shifting toward real assets. Physical assets that hold intrinsic value, generate inflation-hedged income, and align with long-term institutional mandates. Real estate, infrastructure, and natural capital sit at the center of that shift.</p>
      </div>
      <div class="grid g2 rv" style="align-items:start">
        <p style="font-size:16.5px;line-height:1.75;color:#4a463f">Now City operates at the intersection of all three. A regenerative neighborhood combines housing and mixed-use real estate, district-scale infrastructure, and integrated natural systems. Bundled at the neighborhood scale, those categories produce a diversified, durable real-asset profile.</p>
        <p style="font-size:16.5px;line-height:1.75;color:#4a463f">Institutional capital increasingly seeks exactly this combination: stable, inflation-aware, climate-aligned, and impact-credible.</p>
      </div>
    </div>
  </section>

  <!-- OUR MODEL -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head rv">
        <div class="eyebrow">Our model</div>
        <h2>Vertically integrated. Designed for stewardship.</h2>
        <p class="lead">Most real estate platforms specialize in one part of the value chain. We integrate across.</p>
      </div>
      <div class="grid g2 rv" style="align-items:start">
        <p style="font-size:16.5px;line-height:1.75;color:#4a463f">Now City Inc. acquires land, leads pre-development with our integrated stack, develops in partnership with capital and construction partners, and operates and stewards the resulting neighborhoods over decades.</p>
        <div>
          <ol class="numlist">
            {model.map((m) => (
              <li><strong>{m.t}.</strong> {m.d}</li>
            ))}
          </ol>
        </div>
      </div>
      <div class="note rv">Capital structures are designed for long-term stewardship. We seek partners with patient mandates: institutional LPs, family offices, mission-aligned investors, and selective project-level co-investors.</div>
    </div>
  </section>

  <!-- OUTCOMES (measured, dark) -->
  <section class="dark">
    <div class="wrap">
      <div class="sec-head rv">
        <div class="eyebrow">Outcomes</div>
        <h2>A model designed to perform on every dimension that matters.</h2>
        <p class="lead">Financial, social, and ecological outcomes are not separately optimized. They emerge together from the same systems-led approach.</p>
      </div>
      <div class="stats statcards c4 rv">
        {outcomes.map((o) => (
          <div class="stat"><div class="num">{o.k}</div><div class="lbl">{o.d}</div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- PIPELINE -->
  <section>
    <div class="wrap">
      <div class="grid g2 rv" style="align-items:center;gap:44px">
        <div>
          <div class="eyebrow">Pipeline</div>
          <h2 style="font-size:clamp(28px,3.6vw,40px);margin:14px 0 18px;color:var(--ink-deep)">California and the Pacific Northwest.</h2>
          <p style="font-size:16.5px;line-height:1.75;color:#4a463f">We focus on the West Coast, where land use frameworks, climate adaptation needs, and policy momentum align with our model.</p>
          <p style="font-size:16.5px;line-height:1.75;color:#4a463f;margin-top:16px">Sites are at varying stages of pre-development, entitlement, and capital structuring. We do not disclose specific sites publicly. Active partners receive site-level information under appropriate confidentiality.</p>
          <p style="font-size:16.5px;line-height:1.75;color:#4a463f;margin-top:16px">First homes are scheduled for 2029. Multiple sites are positioned to follow.</p>
        </div>
        <div class="figure-block" style="margin-top:0">
          <img src={urbanConnectivity.src} alt="A tilt-shift aerial view of a walkable mixed-density neighborhood, surrounded by mature trees, gardens, and connected open space." loading="lazy" />
          <div class="fig-cap">Concept rendering. Walkable mixed-density neighborhood, West Coast typology.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FUTURE OF OWNERSHIP -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head rv">
        <div class="eyebrow">Future of ownership</div>
        <h2>Designed for what real-asset ownership becomes next.</h2>
      </div>
      <div class="grid g2 rv" style="align-items:start">
        <p style="font-size:16.5px;line-height:1.75;color:#4a463f">Real-asset ownership is evolving. Tokenization, fractional ownership, and digital secondary markets will eventually allow real estate to trade with the transparency, liquidity, and accessibility of public securities, while preserving the durable value characteristics of physical assets.</p>
        <p style="font-size:16.5px;line-height:1.75;color:#4a463f">Now City develops with this future in mind. We design our governance, data infrastructure, and ownership architecture to integrate with digital asset frameworks as those frameworks mature and as regulation catches up.</p>
      </div>
      <div class="note rv">We do not currently offer tokenized securities or any digital ownership instrument. The work today is to build a platform whose ownership layer can evolve with the market, on a clean regulatory footing, when the time is right.</div>
    </div>
  </section>

  <!-- INTEREST FORM -->
  <section id="interest">
    <div class="wrap" style="max-width:760px">
      <div class="sec-head rv">
        <div class="eyebrow">Stay in the loop</div>
        <h2>If this is interesting, tell us.</h2>
        <p class="lead">Complete our investor interest form and we will send you materials and a link to our calendar.</p>
      </div>

      <!--
        Mailchimp endpoint for the "Now City Inc. Investor Interest"
        audience (us19, list id 9c44948c78). Distinct from the NCN
        audience used on nowcity.life.
        Disclaimer text below is verbatim from Brianna and MUST NOT be
        edited without her review. It establishes the regulatory
        posture for this entire page.
      -->
      <form
        action="https://nowcitylabs.us19.list-manage.com/subscribe/post?u=88bfb2c8f34fdd20e85cce03f&amp;id=9c44948c78&amp;f_id=0098bbe7f0"
        method="post"
        target="_blank"
        novalidate
        class="card rv"
        style="display:grid;gap:18px;text-align:left"
      >
        <div>
          <label for="FNAME" style="display:block;font-size:13.5px;font-weight:600;color:var(--ink-deep);margin-bottom:6px">Name <span style="color:var(--terra)">*</span></label>
          <input id="FNAME" name="FNAME" type="text" required autocomplete="name" style="width:100%;box-sizing:border-box;padding:11px 13px;font-size:15px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink-deep)" />
        </div>

        <div>
          <label for="EMAIL" style="display:block;font-size:13.5px;font-weight:600;color:var(--ink-deep);margin-bottom:6px">Email <span style="color:var(--terra)">*</span></label>
          <input id="EMAIL" name="EMAIL" type="email" required autocomplete="email" style="width:100%;box-sizing:border-box;padding:11px 13px;font-size:15px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink-deep)" />
        </div>

        <div>
          <label for="ORG" style="display:block;font-size:13.5px;font-weight:600;color:var(--ink-deep);margin-bottom:6px">Firm or organization <span style="color:#8a8578">(optional)</span></label>
          <input id="ORG" name="ORG" type="text" autocomplete="organization" style="width:100%;box-sizing:border-box;padding:11px 13px;font-size:15px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink-deep)" />
        </div>

        <fieldset style="border:none;padding:0;margin:0">
          <legend style="font-size:13.5px;font-weight:600;color:var(--ink-deep);padding:0;margin-bottom:10px">How would you describe yourself?</legend>
          <div class="grid g2" style="gap:9px">
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="radio" name="group[181122]" value="1" style="accent-color:var(--terra)" /> Individual investor
            </label>
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="radio" name="group[181122]" value="2" style="accent-color:var(--terra)" /> Family office
            </label>
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="radio" name="group[181122]" value="4" style="accent-color:var(--terra)" /> Institutional
            </label>
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="radio" name="group[181122]" value="8" style="accent-color:var(--terra)" /> Foundation or impact
            </label>
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer;grid-column:1 / -1">
              <input type="radio" name="group[181122]" value="16" style="accent-color:var(--terra)" /> Something else
            </label>
          </div>
        </fieldset>

        <fieldset style="border:none;padding:0;margin:0">
          <legend style="font-size:13.5px;font-weight:600;color:var(--ink-deep);padding:0;margin-bottom:4px">What kinds of opportunities interest you?</legend>
          <p style="font-size:12.5px;color:#8a8578;margin:0 0 10px">Optional. Pick anything that fits.</p>
          <div style="display:grid;gap:9px">
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="checkbox" name="group[181123][32]" style="accent-color:var(--terra)" /> Platform-level investment in Now City Inc.
            </label>
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="checkbox" name="group[181123][64]" style="accent-color:var(--terra)" /> Project-level co-investment
            </label>
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="checkbox" name="group[181123][128]" style="accent-color:var(--terra)" /> Strategic partnerships and joint ventures
            </label>
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="checkbox" name="group[181123][256]" style="accent-color:var(--terra)" /> Philanthropic and mission-aligned capital
            </label>
            <label style="display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:14px;color:var(--ink-deep);border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer">
              <input type="checkbox" name="group[181123][512]" style="accent-color:var(--terra)" /> General curiosity
            </label>
          </div>
        </fieldset>

        <div>
          <label for="REFERRAL" style="display:block;font-size:13.5px;font-weight:600;color:var(--ink-deep);margin-bottom:6px">How did you hear about us? <span style="color:#8a8578">(optional)</span></label>
          <input id="REFERRAL" name="REFERRAL" type="text" style="width:100%;box-sizing:border-box;padding:11px 13px;font-size:15px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink-deep)" />
        </div>

        <div>
          <label for="NOTES" style="display:block;font-size:13.5px;font-weight:600;color:var(--ink-deep);margin-bottom:6px">Anything you'd like to share? <span style="color:#8a8578">(optional)</span></label>
          <textarea id="NOTES" name="NOTES" rows="4" style="width:100%;box-sizing:border-box;padding:11px 13px;font-size:15px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink-deep)"></textarea>
        </div>

        <div style="border:1px solid var(--line);background:var(--cream-2);border-radius:7px;padding:16px;font-size:12.5px;line-height:1.7;color:#6a655c">
          <p style="font-weight:600;color:var(--ink-deep);margin:0 0 8px">Disclaimer</p>
          <p style="margin:0">This form is not an offer of securities or a general solicitation. Now City, Inc. is considering an offering of securities exempt from registration under the Securities Act, but has not determined a specific exemption it intends to rely upon. No money or other consideration is being solicited, and if sent, will not be accepted. No sales will be made or commitments to purchase accepted until NowCity, Inc. determines the exemption from registration to rely upon and meets all requirements. Your indication of interest by filling out this form is non-binding.</p>
        </div>

        <!-- Mailchimp anti-bot honeypot. Hidden field; bots fill it, humans don't. -->
        <div style="position:absolute;left:-5000px" aria-hidden="true">
          <input type="text" name="b_88bfb2c8f34fdd20e85cce03f_9c44948c78" tabindex="-1" value="" />
        </div>

        <div>
          <button type="submit" style="border:none;border-radius:6px;background:var(--terra);color:#fff;font-weight:600;font-size:15px;letter-spacing:.06em;padding:14px 26px;cursor:pointer">Submit interest</button>
        </div>
      </form>
    </div>
  </section>
</PreviewLayout>
