---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import urbanConnectivity from '../assets/brand/urban-connectivity.jpg';

const title = 'Investment';
const description =
  'Now City Inc. is building a platform for the next generation of real assets. We are exploring conversations with institutional, family-office, and platform investors aligned with patient capital and regenerative outcomes.';
---

<Layout title={title} description={description}>
  {/* ============================================================ */}
  {/* SECTION 1 — HERO                                             */}
  {/* ============================================================ */}
  <section class="pt-12 md:pt-20">
    <div class="container-wide">
      <div class="max-w-4xl">
        <p class="eyebrow">Investment</p>
        <h1 class="mt-5 font-display text-display-xl text-forest-700">
          Building a platform for the next generation of real assets.
        </h1>
        <p class="lede mt-8 max-w-3xl">
          Now City Inc. develops, operates, and stewards regenerative
          neighborhoods on the West Coast. We are building the team,
          methodology, and capital model to do this at scale.
        </p>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 2 — REAL ASSETS THESIS                               */}
  {/* ============================================================ */}
  <section class="mt-section py-section">
    <div class="container-wide">
      <div class="grid gap-12 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-5">
          <p class="eyebrow">Why real assets</p>
          <h2 class="mt-5 font-display text-display-lg text-forest-700">
            The right kind of asset for the next decade.
          </h2>
        </div>
        <div class="md:col-span-7">
          <div class="prose-body">
            <p>
              Capital is shifting toward real assets. Physical assets
              that hold intrinsic value, generate inflation-hedged
              income, and align with long-term institutional mandates.
              Real estate, infrastructure, and natural capital sit at
              the center of that shift.
            </p>
            <p>
              Now City operates at the intersection of all three. A
              regenerative neighborhood combines housing and mixed-use
              real estate, district-scale infrastructure, and
              integrated natural systems. Bundled at the neighborhood
              scale, those categories produce a diversified, durable
              real-asset profile.
            </p>
            <p>
              Institutional capital increasingly seeks exactly this
              combination: stable, inflation-aware, climate-aligned,
              and impact-credible.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 3 — THE MODEL                                        */}
  {/* ============================================================ */}
  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="grid gap-12 md:grid-cols-12 md:gap-16 md:items-start">
        <div class="md:col-span-5">
          <p class="eyebrow">Our model</p>
          <h2 class="mt-5 font-display text-display-lg text-forest-700">
            Vertically integrated. Designed for stewardship.
          </h2>
          <p class="prose-body mt-8">
            Most real estate platforms specialize in one part of the
            value chain. We integrate across.
          </p>
          <p class="prose-body mt-5">
            Now City Inc. acquires land, leads pre-development with our
            integrated stack, develops in partnership with capital and
            construction partners, and operates and stewards the
            resulting neighborhoods over decades.
          </p>
        </div>
        <div class="md:col-span-7">
          <ol class="grid gap-8">
            <li>
              <div class="h-px w-10 bg-copper-400" aria-hidden="true"></div>
              <p class="eyebrow mt-3">01 / Development</p>
              <p class="prose-body mt-3 text-base">
                Site selection, entitlement, and integrated design
                generate value before construction begins. The pro
                forma follows the systems, not the other way around.
              </p>
            </li>
            <li>
              <div class="h-px w-10 bg-copper-400" aria-hidden="true"></div>
              <p class="eyebrow mt-3">02 / Operations</p>
              <p class="prose-body mt-3 text-base">
                Stabilized neighborhoods generate durable cash flow
                from rent, ground leases, and service revenue, with
                lower lifecycle risk than typical real estate
                portfolios.
              </p>
            </li>
            <li>
              <div class="h-px w-10 bg-copper-400" aria-hidden="true"></div>
              <p class="eyebrow mt-3">03 / Platform</p>
              <p class="prose-body mt-3 text-base">
                Methodology, tools, and data improve every project.
                Services revenue and NowCity.ai software complement
                the core development engine, and every district makes
                the next one cheaper to underwrite.
              </p>
            </li>
          </ol>
          <p class="prose-body mt-10 text-base">
            Capital structures are designed for long-term stewardship.
            We seek partners with patient mandates: institutional LPs,
            family offices, mission-aligned investors, and selective
            project-level co-investors.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 4 — OUTCOMES                                         */}
  {/* ============================================================ */}
  <section class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Outcomes</p>
        <h2 class="mt-5 font-display text-display-lg text-forest-700">
          A model designed to perform on every dimension that matters.
        </h2>
        <p class="lede mt-6">
          Financial, social, and ecological outcomes are not separately
          optimized. They emerge together from the same systems-led
          approach.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <article class="rounded-2xl bg-cream-50 p-8 ring-1 ring-stone-100">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
            Financial
          </p>
          <p class="prose-body mt-4 text-base">
            Lower lifecycle risk through systems-led design. Stabilized
            operating margins from district-scale infrastructure.
            Insurance and resilience advantages.
          </p>
        </article>
        <article class="rounded-2xl bg-cream-50 p-8 ring-1 ring-stone-100">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
            Resident
          </p>
          <p class="prose-body mt-4 text-base">
            Walkable daily life. Lower household transportation cost.
            Measurable health and wellbeing benefits from biophilic
            urbanism.
          </p>
        </article>
        <article class="rounded-2xl bg-cream-50 p-8 ring-1 ring-stone-100">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
            Civic
          </p>
          <p class="prose-body mt-4 text-base">
            Tax base, local employment, attainable mixed-income
            housing. Predictable, well-aligned public-private
            partnerships.
          </p>
        </article>
        <article class="rounded-2xl bg-cream-50 p-8 ring-1 ring-stone-100">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
            Ecological
          </p>
          <p class="prose-body mt-4 text-base">
            Net-positive site outcomes. Stormwater management. Habitat
            restoration. Embodied and operational carbon reduction.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 5 — PIPELINE                                         */}
  {/* ============================================================ */}
  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="grid gap-12 md:grid-cols-2 md:items-center md:gap-16">
        <div>
          <p class="eyebrow">Pipeline</p>
          <h2 class="mt-5 font-display text-display-lg text-forest-700">
            California and the Pacific Northwest.
          </h2>
          <p class="prose-body mt-8">
            We focus on the West Coast, where land use frameworks,
            climate adaptation needs, and policy momentum align with
            our model.
          </p>
          <p class="prose-body mt-5">
            Sites are at varying stages of pre-development,
            entitlement, and capital structuring. We do not disclose
            specific sites publicly. Active partners receive
            site-level information under appropriate confidentiality.
          </p>
          <p class="prose-body mt-5">
            First homes are scheduled for 2029. Multiple sites are
            positioned to follow.
          </p>
        </div>
        <div class="overflow-hidden rounded-md shadow-sm">
          <Image
            src={urbanConnectivity}
            alt="A tilt-shift aerial view of a walkable mixed-density neighborhood, surrounded by mature trees, gardens, and connected open space."
            widths={[600, 900, 1400]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="h-auto w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 6 — FUTURE OF OWNERSHIP                              */}
  {/* ============================================================ */}
  <section class="py-section">
    <div class="container-wide">
      <div class="grid gap-12 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-5">
          <p class="eyebrow">Future of ownership</p>
          <h2 class="mt-5 font-display text-display-lg text-forest-700">
            Designed for what real-asset ownership becomes next.
          </h2>
        </div>
        <div class="md:col-span-7">
          <div class="prose-body">
            <p>
              Real-asset ownership is evolving. Tokenization,
              fractional ownership, and digital secondary markets will
              eventually allow real estate to trade with the
              transparency, liquidity, and accessibility of public
              securities, while preserving the durable value
              characteristics of physical assets.
            </p>
            <p>
              Now City develops with this future in mind. We design our
              governance, data infrastructure, and ownership
              architecture to integrate with digital asset frameworks
              as those frameworks mature and as regulation catches up.
            </p>
            <p>
              We do not currently offer tokenized securities or any
              digital ownership instrument. The work today is to build
              a platform whose ownership layer can evolve with the
              market, on a clean regulatory footing, when the time is
              right.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================ */}
  {/* SECTION 7 — INTEREST FORM                                    */}
  {/* ============================================================ */}
  <section id="interest" class="py-section bg-cream-50">
    <div class="container-narrow">
      <div class="max-w-3xl">
        <p class="eyebrow">Stay in the loop</p>
        <h2 class="mt-5 font-display text-display-lg text-forest-700">
          If this is interesting, tell us.
        </h2>
        <p class="prose-body mt-6">
          Complete our investor interest form and we will send you
          materials and a link to our calendar.
        </p>
      </div>

      {/*
        Mailchimp endpoint for the "Now City Inc. — Investor Interest"
        audience (us19, list id 9c44948c78). Distinct from the NCN
        audience used on nowcity.life.
        Disclaimer text below is verbatim from Brianna and MUST NOT be
        edited without her review. It establishes the regulatory
        posture for this entire page.
      */}
      <form
        action="https://nowcitylabs.us19.list-manage.com/subscribe/post?u=88bfb2c8f34fdd20e85cce03f&amp;id=9c44948c78&amp;f_id=0098bbe7f0"
        method="post"
        target="_blank"
        novalidate
        class="mt-10 grid gap-5 rounded-2xl bg-cream p-8 ring-1 ring-stone-100 md:p-10"
      >
        <div>
          <label for="FNAME" class="block text-sm font-medium text-forest-800">
            Name <span class="text-copper-400">*</span>
          </label>
          <input
            id="FNAME"
            name="FNAME"
            type="text"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 placeholder:text-stone-400 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20"
          />
        </div>

        <div>
          <label for="EMAIL" class="block text-sm font-medium text-forest-800">
            Email <span class="text-copper-400">*</span>
          </label>
          <input
            id="EMAIL"
            name="EMAIL"
            type="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 placeholder:text-stone-400 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20"
          />
        </div>

        <div>
          <label for="ORG" class="block text-sm font-medium text-forest-800">
            Firm or organization <span class="text-stone-400">(optional)</span>
          </label>
          <input
            id="ORG"
            name="ORG"
            type="text"
            autocomplete="organization"
            class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 placeholder:text-stone-400 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20"
          />
        </div>

        <fieldset>
          <legend class="block text-sm font-medium text-forest-800">
            How would you describe yourself?
          </legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="radio" name="group[181122]" value="1" class="accent-forest-700" />
              Individual investor
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="radio" name="group[181122]" value="2" class="accent-forest-700" />
              Family office
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="radio" name="group[181122]" value="4" class="accent-forest-700" />
              Institutional
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="radio" name="group[181122]" value="8" class="accent-forest-700" />
              Foundation or impact
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5 sm:col-span-2">
              <input type="radio" name="group[181122]" value="16" class="accent-forest-700" />
              Something else
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="block text-sm font-medium text-forest-800">
            What kinds of opportunities interest you?
          </legend>
          <p class="mt-1 text-xs text-stone-500">Optional. Pick anything that fits.</p>
          <div class="mt-3 grid gap-2">
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="checkbox" name="group[181123][32]" class="accent-forest-700" />
              Platform-level investment in Now City Inc.
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="checkbox" name="group[181123][64]" class="accent-forest-700" />
              Project-level co-investment
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="checkbox" name="group[181123][128]" class="accent-forest-700" />
              Strategic partnerships and joint ventures
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="checkbox" name="group[181123][256]" class="accent-forest-700" />
              Philanthropic and mission-aligned capital
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5">
              <input type="checkbox" name="group[181123][512]" class="accent-forest-700" />
              General curiosity
            </label>
          </div>
        </fieldset>

        <div>
          <label for="REFERRAL" class="block text-sm font-medium text-forest-800">
            How did you hear about us? <span class="text-stone-400">(optional)</span>
          </label>
          <input
            id="REFERRAL"
            name="REFERRAL"
            type="text"
            class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 placeholder:text-stone-400 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20"
          />
        </div>

        <div>
          <label for="NOTES" class="block text-sm font-medium text-forest-800">
            Anything you'd like to share? <span class="text-stone-400">(optional)</span>
          </label>
          <textarea
            id="NOTES"
            name="NOTES"
            rows="4"
            class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 placeholder:text-stone-400 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20"
          ></textarea>
        </div>

        <div class="rounded-md border border-stone-200 bg-cream-50 p-5 text-xs leading-relaxed text-stone-600">
          <p class="font-medium text-forest-800">Disclaimer</p>
          <p class="mt-2">
            This form is not an offer of securities or a general
            solicitation. Now City, Inc. is considering an offering of
            securities exempt from registration under the Securities
            Act, but has not determined a specific exemption it intends
            to rely upon. No money or other consideration is being
            solicited, and if sent, will not be accepted. No sales will
            be made or commitments to purchase accepted until NowCity,
            Inc. determines the exemption from registration to rely
            upon and meets all requirements. Your indication of
            interest by filling out this form is non-binding.
          </p>
        </div>

        {/* Mailchimp anti-bot honeypot. Hidden field; bots fill it, humans don't. */}
        <div style="position:absolute;left:-5000px" aria-hidden="true">
          <input type="text" name="b_88bfb2c8f34fdd20e85cce03f_9c44948c78" tabindex="-1" value="" />
        </div>

        <div class="mt-2">
          <button type="submit" class="btn-primary">
            Submit interest
          </button>
        </div>
      </form>
    </div>
  </section>
</Layout>
