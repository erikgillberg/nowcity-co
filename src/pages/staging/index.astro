---
import Staging from '../../layouts/StagingLayout.astro';
import { Image } from 'astro:assets';
import heroVision from '../../assets/brand/hero-vision.jpg';
import wcVillage from '../../assets/watercolors/village-green.jpg';
import wcMain from '../../assets/watercolors/street-mainstreet.jpg';
import wcEve from '../../assets/watercolors/commons-evening.jpg';
import wcBoard from '../../assets/watercolors/greenway-boardwalk.jpg';
import wcRoofs from '../../assets/watercolors/aerial-greenroofs.jpg';
import wcPath from '../../assets/watercolors/park-path.jpg';
import wcMkt from '../../assets/watercolors/street-market.jpg';
import wcShop from '../../assets/watercolors/market-shop.jpg';
import wcNight from '../../assets/watercolors/plaza-night.jpg';
import wcGondola from '../../assets/watercolors/street-gondola.jpg';
---
<Staging
  title="Home"
  eyebrow="Now City Inc."
  heading="Cities designed for<br /><em style='color:#fff'>everyday vitality</em>."
  sub="Now City Inc. is a regenerative developer and operator. Through adaptive reuse and ground-up construction, we turn underused sites into walkable, green, mixed-use districts across the West Coast."
  heroImg={heroVision}
  heroAlt="An active mixed-use street with plant-clad buildings, a market, café tables, a bike lane, and people of all ages."
  heroCaption="The vision, hand-crafted: a Now City street, Pacific Northwest typology."
>
  <div slot="hero-extra" class="btns" style="margin-top:30px">
    <a href="/staging/services/" class="btn sun">See our services</a>
    <a href="/staging/approach/" class="btn ghost-light">Our approach</a>
  </div>

  <section style="padding:56px 0;background:var(--paper-2);border-bottom:1px solid var(--line)">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:30px">
      <div style="display:flex;gap:14px" data-reveal>
        <svg class="icon" viewBox="0 0 24 24"><path d="M4 20c8 0 12-4 14-12M8 20c0-6 4-10 12-12M4 12c3 0 5-1 7-3"/></svg>
        <div><h3>Adaptive reuse</h3><p class="muted" style="font-size:14px;margin-top:4px">Value hiding in what is already built.</p></div>
      </div>
      <div style="display:flex;gap:14px" data-reveal>
        <svg class="icon" viewBox="0 0 24 24"><path d="M3 21h18M6 21V9l6-5 6 5v12M10 21v-5h4v5"/></svg>
        <div><h3>Ground-up districts</h3><p class="muted" style="font-size:14px;margin-top:4px">Whole neighborhoods, not single assets.</p></div>
      </div>
      <div style="display:flex;gap:14px" data-reveal>
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 21c-4-4-7-7.6-7-11a7 7 0 1 1 14 0c0 3.4-3 7-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
        <div><h3>West Coast</h3><p class="muted" style="font-size:14px;margin-top:4px">California and the Pacific Northwest.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap duo">
      <div data-reveal>
        <hr class="rule" />
        <p class="eyebrow">What we do</p>
        <h2 style="margin-top:16px">A different kind of real estate company.</h2>
        <div style="margin-top:28px;border-radius:14px;overflow:hidden;box-shadow:0 16px 40px rgba(51,89,122,.14)">
          <Image src={wcMain} alt="Watercolor: a lively brick main street under a blue sky" widths={[700,1100]} sizes="(min-width:820px) 440px, 100vw" />
        </div>
      </div>
      <div class="prose" data-reveal>
        <p>Most development optimizes for a single asset, a single capital structure, and a single transaction. We optimize for a place over decades.</p>
        <p>Now City Inc. is a vertically integrated developer and operator. We find the value hiding in underused land and buildings, then release it through adaptive reuse and ground-up construction, designed and built with a systems-led approach to urbanism. We steward the result long after construction. Our model treats a district as a coordinated system rather than a portfolio of buildings.</p>
        <p>The result: better outcomes for residents, lower lifecycle risk for capital, more resilient places for cities.</p>
      </div>
    </div>
  </section>

  <div class="wcband to-dark" style={`background-image:url(${wcEve.src})`} role="img" aria-label="Watercolor: a neighborhood commons at dusk"></div>

  <section class="darksec">
    <div class="wrap">
      <p class="eyebrow" data-reveal>The difference, measured</p>
      <h2 style="margin-top:16px" data-reveal>Better places perform better.</h2>
      <p class="lede" style="margin-top:14px" data-reveal>Versus a traditional equivalent, from our underwriting and the research behind it.</p>
      <div class="statgrid" data-reveal>
        <div><div class="n">+300–500 bps</div><div class="l">Higher financial ROI over the full hold.</div></div>
        <div><div class="n">2–3×</div><div class="l">Social return: health, connection, and household savings.</div></div>
        <div><div class="n">Net-positive</div><div class="l">Site ecology: stormwater, habitat, soil, and canopy.</div></div>
        <div><div class="n">Decades</div><div class="l">Designed to improve with time, not depreciate against it.</div></div>
      </div>
    </div>
  </section>

  <section style="background:var(--paper-2)">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Our mission</p>
      <h2 style="margin-top:16px;max-width:640px" data-reveal>Designed for everyday vitality.</h2>
      <p class="lede" style="margin-top:16px" data-reveal>Now City’s mission is to accelerate the transition to regenerative, resilient, and equitable communities and cities.</p>
      <div class="cards">
        <div class="card" data-reveal>
          <div class="ph"><Image src={wcBoard} alt="Watercolor: a boardwalk winding through restored riverbank wetlands" widths={[600,900]} sizes="400px" /></div>
          <div class="tx"><div class="icon-row"><svg class="icon" viewBox="0 0 24 24"><path d="M6 20c6-1 10-5 12-14-7 1-12 5-12 14zM6 20c2-3 5-6 8-8"/></svg><h3>Regeneration</h3></div>
          <p>Restore the natural systems that sustain daily life (clean air, water, soil, and food), improving personal health while rebuilding ecological function at the neighborhood and district scale.</p></div>
        </div>
        <div class="card" data-reveal>
          <div class="ph"><Image src={wcRoofs} alt="Watercolor: apartment blocks with green roofs and solar panels" widths={[600,900]} sizes="400px" /></div>
          <div class="tx"><div class="icon-row"><svg class="icon" viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg><h3>Resilience</h3></div>
          <p>Homes, mobility, energy, food, and social systems are designed to perform under stress (climate and economic disruption), strengthening household security and community-wide stability.</p></div>
        </div>
        <div class="card" data-reveal>
          <div class="ph"><Image src={wcPath} alt="Watercolor: a shaded park path with people of all ages" widths={[600,900]} sizes="400px" /></div>
          <div class="tx"><div class="icon-row"><svg class="icon" viewBox="0 0 24 24"><circle cx="8" cy="7" r="2.6"/><circle cx="16" cy="7" r="2.6"/><path d="M3.5 20c.5-4 2-6 4.5-6s4 2 4.5 6M11.5 20c.5-4 2-6 4.5-6s4 2 4.5 6"/></svg><h3>Equity</h3></div>
          <p>Designing around the realities of caregiving, childhood, aging, mobility independence, and access to opportunity improves daily life for individuals while creating more stable, connected, and inclusive communities for all.</p></div>
        </div>
      </div>
    </div>
  </section>

  <div class="wcband" style={`background-image:url(${wcVillage.src})`} role="img" aria-label="Watercolor: a village green with homes and gardens"></div>

  <section>
    <div class="wrap">
      <p class="eyebrow" data-reveal>Our brands</p>
      <h2 style="margin-top:16px" data-reveal>Three doors. One company.</h2>
      <p class="lede" style="margin-top:16px" data-reveal>Now City Inc. is the parent of three brands. Each serves a distinct audience in the same regenerative urbanism.</p>
      <div class="doors">
        <a class="door" href="https://nowcity.life" data-reveal>
          <Image src={wcMkt} alt="" widths={[700,1000]} sizes="400px" />
          <div class="tx"><p class="eyebrow on-img">For residents</p><h3>Now City Neighborhoods</h3><p>The places we build, designed for the parts of life that happen every day. Future residents follow along here.</p><span class="go">nowcity.life →</span></div>
        </a>
        <a class="door" href="/staging/services/" data-reveal>
          <Image src={wcShop} alt="" widths={[700,1000]} sizes="400px" />
          <div class="tx"><p class="eyebrow on-img">For landowners and operators</p><h3>Now City Labs</h3><p>Pre-development intelligence and integrated execution services for landowners, operators, and municipalities.</p><span class="go">Explore services →</span></div>
        </a>
        <a class="door" href="https://nowcity.ai" data-reveal>
          <Image src={wcNight} alt="" widths={[700,1000]} sizes="400px" />
          <div class="tx"><p class="eyebrow on-img">For deal teams and capital partners</p><h3>NowCity.ai</h3><p>Collaborative underwriting software built by Now City: live models the whole team can drive together, every number traced to its source.</p><span class="go">nowcity.ai →</span></div>
        </a>
      </div>
    </div>
  </section>

  <div class="wcband" style={`background-image:url(${wcGondola.src})`} role="img" aria-label="Watercolor: a street with cable-car gondolas overhead"></div>

  <section style="padding-bottom:110px">
    <div class="wrap" style="text-align:center">
      <p class="eyebrow" data-reveal>Get involved</p>
      <h2 style="margin-top:16px" data-reveal>Help us build places that keep getting better.</h2>
      <p class="lede" style="margin:18px auto 0" data-reveal>Whether you steward land, deploy capital, run a city, or just want to live somewhere better, there is a door for you.</p>
      <div class="btns" style="justify-content:center;margin-top:30px" data-reveal>
        <a href="/staging/contact/" class="btn sky">Get in touch</a>
        <a href="/staging/investment/" class="btn ghost">Investment</a>
      </div>
    </div>
  </section>
</Staging>
